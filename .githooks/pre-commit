#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

export DOTNET_CLI_HOME="${DOTNET_CLI_HOME:-/tmp}"

if ! command -v dotnet >/dev/null 2>&1; then
  echo "dotnet SDK is required for pre-commit formatting." >&2
  exit 1
fi

echo "Running dotnet format..."
dotnet format whitespace BopVisualEffects.sln --verbosity minimal --exclude BopVisualEffects/obj --exclude BopVisualEffects/bin
dotnet format style BopVisualEffects.sln --verbosity minimal --exclude BopVisualEffects/obj --exclude BopVisualEffects/bin
dotnet format analyzers BopVisualEffects.sln --verbosity minimal --exclude BopVisualEffects/obj --exclude BopVisualEffects/bin

git add -u

echo "Formatting complete."
