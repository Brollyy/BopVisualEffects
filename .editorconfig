root = true

[*]
charset = utf-8
insert_final_newline = true
end_of_line = lf
trim_trailing_whitespace = true

[*.csproj]
indent_style = space
indent_size = 2

[*.{props,targets}]
indent_style = space
indent_size = 2

[*.sln]
indent_style = tab

[*.cs]
indent_style = tab
tab_width = 4
indent_size = 4

[**/MyPluginInfo.cs]
dotnet_diagnostic.CA1707.severity = none
